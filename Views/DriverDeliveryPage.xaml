<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Droppa.Views.DriverDeliveryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Droppa.ViewModels"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:DataType="vm:DriverDeliveryViewModel"
    Title="Active delivery">

    <!-- The map lives in its own fixed row, NOT inside the ScrollView. On Android the native map
         surface renders unreliably (often blank) inside a scrolling container, so we keep it in a
         dedicated Grid row and let only the details below scroll. -->
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="12">

            <!-- Page header: title + live date/time on the left, signed-in driver top-right -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Active delivery" FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource Brand}" />
                    <Label Text="{Binding CurrentDateTime}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                    <Label Text="Signed in as" FontSize="10" TextColor="Gray" HorizontalTextAlignment="End" />
                    <Label Text="{Binding UserName}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>

            <!-- Trip headline card, in the same brand-blue style as the customer's home cards -->
            <Border StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{StaticResource Brand}">
                <VerticalStackLayout Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding CategoryLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="1" Text="{Binding Reference}" TextColor="White" Opacity="0.8" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding StatusText, StringFormat='Status: {0}'}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Live map. Before collection it previews the way out to the pickup; once the parcel
                 is collected it switches to the full source → destination journey, drawn like a
                 Google Maps directions view (chosen route solid blue, alternatives behind it). -->
            <Border StrokeShape="RoundRectangle 16" Padding="0" HeightRequest="250">
                <maps:Map x:Name="RouteMap" IsShowingUser="True"
                          IsZoomEnabled="True" IsScrollEnabled="True" />
            </Border>

            <!-- One chip per route alternative, matching the lines on the map: the chosen (shortest)
                 route is filled blue, the rest are outlined. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding HasRouteOptions}">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RouteOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RouteOption">
                            <Border StrokeShape="RoundRectangle 10" Padding="12,6"
                                    BackgroundColor="White" Stroke="#A3B6EE">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsChosen}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#2B22CE" />
                                        <Setter Property="Stroke" Value="#2B22CE" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding DurationText}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#2B22CE">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding DistanceText}" FontSize="11" TextColor="Gray">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding ViaText}" FontSize="10" TextColor="Gray"
                                           IsVisible="{Binding ViaText, Converter={StaticResource IsStringNotEmpty}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="{Binding RouteInfoText}" TextColor="{StaticResource Brand}" FontSize="10" />

        </VerticalStackLayout>

        <!-- Everything below scrolls inside the white card the customer's pages use -->
        <Frame Grid.Row="1" Padding="0" CornerRadius="16" HasShadow="True"
               BorderColor="{StaticResource Gray200}" BackgroundColor="White">
            <ScrollView>
                <VerticalStackLayout Padding="18" Spacing="14">

                    <Border StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CourierName, StringFormat='Courier: {0}'}" />
                            <Label Text="{Binding PickupText, StringFormat='📍 Pickup: {0}'}" />
                            <Label Text="{Binding DestinationText, StringFormat='🏁 Drop-off: {0}'}" />
                            <Label Text="{Binding SharingText}" TextColor="{StaticResource Brand}" FontSize="13" Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Advance the delivery: strictly one step at a time. Each button only appears
                         once the server has confirmed the step before it, so the driver can't skip
                         ahead or mark things out of order. -->
                    <Label Text="Advance the delivery" FontSize="18" FontAttributes="Bold" Margin="0,4,0,0"
                           IsVisible="{Binding ShowAdvanceSection}" />
                    <Label Text="{Binding StepHintText}" TextColor="Gray" FontSize="12" />
                    <Button Text="Mark parcel collected" Command="{Binding MarkCollectedCommand}"
                            IsVisible="{Binding ShowCollectStep}" IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Brand}" TextColor="White" />
                    <Button Text="Mark in transit" Command="{Binding MarkInTransitCommand}"
                            IsVisible="{Binding ShowInTransitStep}" IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Brand}" TextColor="White" />
                    <Button Text="Mark delivered" Command="{Binding MarkDeliveredCommand}"
                            IsVisible="{Binding ShowDeliveredStep}" IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Secondary}" TextColor="Black" />

                    <!-- Remit to courier: transfer the amount the customer owes at the courier office
                         (COD / handling, which the customer prepaid to Droppa) to the courier's
                         number. This is NOT the distance ride fee. Only relevant once the parcel is
                         actually in hand, and only when there is an amount to remit. -->
                    <Border StrokeShape="RoundRectangle 12" Padding="16" Margin="0,8,0,0"
                            IsVisible="{Binding ShowRemitSection}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Remit to courier" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding TransferAmountText, StringFormat='Amount owed at courier: {0}'}" />
                            <Label Text="{Binding TransferStatusText}" TextColor="{StaticResource Brand}" FontSize="13" />
                            <Button Text="{Binding TransferAmountText, StringFormat='Transfer {0} to courier'}"
                                    Command="{Binding TransferToCourierCommand}"
                                    IsEnabled="{Binding CanTransfer}"
                                    BackgroundColor="{StaticResource Brand}" TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                </VerticalStackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>
