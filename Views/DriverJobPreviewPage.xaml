<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Droppa.Views.DriverJobPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Droppa.ViewModels"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:DataType="vm:DriverJobPreviewViewModel"
    Title="Job preview">

    <!-- The map sits in its own fixed row (it renders unreliably inside a ScrollView on Android).
         Header on top, scrolling details in the middle, Accept/Deny pinned at the bottom. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Page header: title + live date/time on the left, signed-in driver top-right -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Job preview" FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{Binding CurrentDateTime}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                <Label Text="Signed in as" FontSize="10" TextColor="Gray" HorizontalTextAlignment="End" />
                <Label Text="{Binding UserName}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </Grid>

        <!-- Customer location on the map -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 16" Padding="0" HeightRequest="280">
            <maps:Map x:Name="JobMap" IsShowingUser="True" IsZoomEnabled="True" IsScrollEnabled="True" />
        </Border>

        <!-- Trip details inside a framed scroll area -->
        <Frame Grid.Row="2" Padding="0" CornerRadius="16" HasShadow="True"
               BorderColor="{StaticResource Gray200}" BackgroundColor="White">
            <ScrollView>
                <VerticalStackLayout Padding="18" Spacing="6">
                    <Label Text="{Binding CategoryLabel}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Reference}" TextColor="Gray" FontSize="13" />
                    <Label Text="{Binding CourierName}" Margin="0,4,0,0" />
                    <Label Text="{Binding PickupText}" />
                    <Label Text="{Binding DestinationText}" />
                    <Label Text="{Binding TripDistanceText}" />
                    <Label Text="{Binding DistanceFromDriverText}" TextColor="Gray" FontSize="13" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,8" />
                    <Label Text="Trip fee" FontSize="13" TextColor="Gray" />
                    <Label Text="{Binding FeeText}" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding ErrorMessage}" TextColor="Red" Margin="0,8,0,0"
                           IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
            </ScrollView>
        </Frame>

        <!-- Accept / Deny pinned to the bottom -->
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Accept" Command="{Binding AcceptCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                <Button Grid.Column="1" Text="Deny" Command="{Binding DenyCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
