<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Droppa.Views.ParcelChargePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Droppa.ViewModels"
    x:DataType="vm:ParcelChargeViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border StrokeShape="RoundRectangle 16" Padding="0" BackgroundColor="White"
            WidthRequest="340" Stroke="{StaticResource Gray200}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="Parcel fee" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{Binding Reference, StringFormat='Delivery {0}'}" FontSize="12" TextColor="Gray" />
                <Label Text="The rider has weighed your parcel. Confirm the fee and pay to continue your delivery."
                       FontSize="13" TextColor="Gray" />

                <!-- Charge breakdown -->
                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />
                <Label Text="{Binding WeightText, StringFormat='Weight: {0}'}" />
                <Label Text="{Binding WeightAmount, StringFormat='Weight charge: MWK {0:N0}'}" />
                <Label Text="{Binding Vat, StringFormat='VAT (17.5%): MWK {0:N0}'}" />
                <Label Text="{Binding ParcelCharge, StringFormat='Total to pay: MWK {0:N0}'}"
                       FontSize="18" FontAttributes="Bold" Margin="0,2,0,0" />

                <!-- Payment -->
                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />
                <Label Text="Payment" FontAttributes="Bold" />
                <Picker Title="Payment method"
                        ItemsSource="{Binding Payment.Methods}"
                        SelectedItem="{Binding Payment.SelectedMethod}" />

                <!-- Mobile money — charged to the customer's registered number (read-only) -->
                <VerticalStackLayout Spacing="2" IsVisible="{Binding Payment.IsMobileMoney}">
                    <Label Text="Paying from your registered number" FontSize="11" TextColor="Gray" />
                    <Entry Placeholder="No mobile number on your profile" Keyboard="Telephone"
                           IsReadOnly="True" Text="{Binding Payment.MobileNumber}" />
                </VerticalStackLayout>

                <!-- Visa card -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding Payment.IsCard}">
                    <Entry Placeholder="Card number" Keyboard="Numeric" Text="{Binding Payment.CardNumber}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="MM/YY" Text="{Binding Payment.CardExpiry}" />
                        <Entry Grid.Column="1" Placeholder="CVV" Keyboard="Numeric"
                               IsPassword="True" Text="{Binding Payment.CardCvv}" />
                    </Grid>
                </VerticalStackLayout>

                <Button Text="{Binding Payment.PayButtonText}" Command="{Binding Payment.PayCommand}"
                        IsEnabled="{Binding Payment.IsNotPaid}" Margin="0,4,0,0" />
                <ActivityIndicator IsRunning="{Binding Payment.IsProcessing}"
                                   IsVisible="{Binding Payment.IsProcessing}" />
                <Label Text="{Binding Payment.StatusMessage}" FontSize="13"
                       TextColor="{StaticResource Primary}"
                       IsVisible="{Binding Payment.StatusMessage, Converter={StaticResource IsStringNotEmpty}}" />

                <Button Text="Pay later" Command="{Binding LaterCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</toolkit:Popup>
