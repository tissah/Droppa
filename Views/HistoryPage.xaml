<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Droppa.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Droppa.ViewModels"
    xmlns:models="clr-namespace:Droppa.Models"
    x:DataType="vm:HistoryViewModel"
    Title="My deliveries">

    <Grid Padding="16" RowDefinitions="*">
        <CollectionView ItemsSource="{Binding Bookings}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" VerticalOptions="Center">
                    <Label Text="No deliveries yet." HorizontalOptions="Center" FontSize="16" />
                    <Label Text="Your booked deliveries will appear here." HorizontalOptions="Center" TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Reference}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Courier.Name, StringFormat='Courier: {0}'}" />
                            <Label Text="{Binding DistanceKm, StringFormat='Distance: {0:F2} km'}" />
                            <Label Text="{Binding TotalFee, StringFormat='Fee: MWK {0:N0}'}" />

                            <!-- Order summary -->
                            <Label Text="Order summary" FontAttributes="Bold" Margin="0,8,0,0" />
                            <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Timeline}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrderStage">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Glyph}" FontSize="14"
                                                   TextColor="{Binding Highlight, Converter={StaticResource DoneColor}}" />
                                            <Label Text="{Binding Title}" FontSize="14"
                                                   TextColor="{Binding Highlight, Converter={StaticResource DoneColor}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="⚠ This order was cancelled." TextColor="Red" FontSize="13"
                                   IsVisible="{Binding IsCancelled}" Margin="0,2,0,0" />

                            <Button Text="Track driver" Margin="0,6,0,0"
                                    IsVisible="{Binding CanTrack}"
                                    Command="{Binding Path=TrackCommand, x:DataType=vm:HistoryViewModel, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}}"
                                    CommandParameter="{Binding .}" />

                            <Button Text="Cancel trip" Margin="0,6,0,0"
                                    BackgroundColor="Transparent" TextColor="Red" BorderColor="Red" BorderWidth="1"
                                    IsVisible="{Binding CanCancel}"
                                    Command="{Binding Path=CancelCommand, x:DataType=vm:HistoryViewModel, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
