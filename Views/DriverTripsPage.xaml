<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Droppa.Views.DriverTripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Droppa.ViewModels"
    xmlns:models="clr-namespace:Droppa.Models"
    xmlns:converters="clr-namespace:Droppa.Converters"
    x:DataType="vm:DriverTripsViewModel"
    Title="My trips">

    <ContentPage.Resources>
        <!-- Active tab is filled with the brand colour; inactive tabs are transparent. -->
        <converters:BoolToColorConverter x:Key="TabBg"
                                         TrueColor="{StaticResource Brand}"
                                         FalseColor="Transparent" />
        <converters:BoolToColorConverter x:Key="TabText"
                                         TrueColor="White"
                                         FalseColor="{StaticResource Brand}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Page header: title + live date/time on the left, signed-in driver top-right -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="My trips" FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource Brand}" />
                <Label Text="{Binding CurrentDateTime}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                <Label Text="Signed in as" FontSize="10" TextColor="Gray" HorizontalTextAlignment="End" />
                <Label Text="{Binding UserName}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </Grid>

        <!-- Tab headers: To pick up (not yet collected) / To deliver (collected, in transit) -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 12" StrokeThickness="1"
                Stroke="{StaticResource Brand}" Padding="3">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                <Button Grid.Column="0"
                        Text="{Binding PickUpHeader}"
                        Command="{Binding ShowPickUpCommand}"
                        CornerRadius="9" HeightRequest="44" FontSize="14" FontAttributes="Bold"
                        BackgroundColor="{Binding IsPickUpTab, Converter={StaticResource TabBg}}"
                        TextColor="{Binding IsPickUpTab, Converter={StaticResource TabText}}" />
                <Button Grid.Column="1"
                        Text="{Binding DeliverHeader}"
                        Command="{Binding ShowDeliverCommand}"
                        CornerRadius="9" HeightRequest="44" FontSize="14" FontAttributes="Bold"
                        BackgroundColor="{Binding IsDeliverTab, Converter={StaticResource TabBg}}"
                        TextColor="{Binding IsDeliverTab, Converter={StaticResource TabText}}" />
            </Grid>
        </Border>

        <!-- Tab content: one list is visible at a time depending on the active tab -->
        <Frame Grid.Row="2" Padding="0" CornerRadius="16" HasShadow="True"
               BorderColor="{StaticResource Gray200}" BackgroundColor="White">
            <ScrollView>
                <Grid Padding="16">

                    <!-- To pick up tab: accepted but not yet collected. Brand-blue action cards,
                         the same look as the customer's home cards. -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPickUpTab}">
                        <Label Text="No pickups pending." TextColor="Gray" IsVisible="{Binding HasNoPickups}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ToPickUp}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DriverTrip">
                                    <Border StrokeShape="RoundRectangle 16" Padding="20"
                                            BackgroundColor="{StaticResource Brand}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=OpenTripCommand, x:DataType=vm:DriverTripsViewModel, Source={RelativeSource AncestorType={x:Type vm:DriverTripsViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding PickupTitle}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="{Binding CategoryLabel, StringFormat='{0}'}" FontSize="13" TextColor="White" Opacity="0.8" />
                                            <Label Text="{Binding Reference}" FontSize="13" TextColor="White" Opacity="0.8" />
                                            <Label Text="{Binding PickupLocationText, StringFormat='📍 {0}'}" TextColor="White" />
                                            <Label Text="{Binding StatusLabel, StringFormat='Status: {0}'}" FontSize="13" TextColor="White" />
                                            <Button Text="Weigh &amp; collect"
                                                    BackgroundColor="White" TextColor="Black" Margin="0,8,0,0"
                                                    Command="{Binding Path=OpenTripCommand, x:DataType=vm:DriverTripsViewModel, Source={RelativeSource AncestorType={x:Type vm:DriverTripsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- To deliver tab: collected ("frozen" out of pickups), on the way to the destination.
                         Uses the lighter summary panel the customer's quote screens use. -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsDeliverTab}">
                        <Label Text="Nothing collected yet." TextColor="Gray" IsVisible="{Binding HasNoDeliveries}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ToDeliver}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DriverTrip">
                                    <Border StrokeShape="RoundRectangle 16" Padding="20"
                                            BackgroundColor="{StaticResource Secondary}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=OpenTripCommand, x:DataType=vm:DriverTripsViewModel, Source={RelativeSource AncestorType={x:Type vm:DriverTripsViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding DeliveryTitle}" FontSize="20" FontAttributes="Bold" />
                                            <Label Text="🔒 Picked up — deliver to destination" FontSize="12" TextColor="Gray" />
                                            <Label Text="{Binding Reference}" FontSize="13" TextColor="Gray" />
                                            <Label Text="{Binding DeliveryLocationText, StringFormat='🏁 {0}'}" />
                                            <Label Text="{Binding StatusLabel, StringFormat='Status: {0}'}" FontSize="13" />
                                            <Button Text="Continue delivery" Margin="0,8,0,0"
                                                    BackgroundColor="{StaticResource Brand}" TextColor="White"
                                                    Command="{Binding Path=OpenTripCommand, x:DataType=vm:DriverTripsViewModel, Source={RelativeSource AncestorType={x:Type vm:DriverTripsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </Grid>
            </ScrollView>
        </Frame>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Brand}" TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
