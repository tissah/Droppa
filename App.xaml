<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Droppa"
             xmlns:converters="clr-namespace:Droppa.Converters"
             x:Class="Droppa.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
            <converters:BoolToColorConverter x:Key="DoneColor"
                                             TrueColor="{StaticResource Primary}"
                                             FalseColor="{StaticResource Gray300}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
