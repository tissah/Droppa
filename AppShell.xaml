<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Droppa.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Droppa.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Droppa">

    <!-- Startup page: branded splash. It navigates to "//login" once it has been shown. -->
    <ShellContent
        Route="splash"
        ContentTemplate="{DataTemplate views:SplashPage}" />

    <!-- Authentication -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />
    
    <!--redirection to login page on startup-->
    <!--ShellContent
        Route="main"
        ContentTemplate="{DataTemplate views:DriverTripsPage}"
        />-->

    <!-- Customer app, shown after sign-in via GoToAsync("//main") -->
    <TabBar Route="main">
        <ShellContent
        Title="Home"
        Icon="icon_home.png"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="home" />
        <ShellContent
        Title="Deliveries"
        Icon="icon_deliveries.png"
        ContentTemplate="{DataTemplate views:HistoryPage}"
        Route="history" />
    </TabBar>

    <!-- Driver app, shown after sign-in via GoToAsync("//driver"). No send/receive here. -->
    <TabBar Route="driver">
        <ShellContent
            Title="Pickups"
            Icon="icon_home.png"
            ContentTemplate="{DataTemplate views:DriverJobsPage}"
            Route="jobs" />
        <ShellContent
            Title="My Trips"
            Icon="icon_deliveries.png"
            ContentTemplate="{DataTemplate views:DriverTripsPage}"
            Route="trips" />
    </TabBar>

</Shell>
